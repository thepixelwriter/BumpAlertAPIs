{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bumpalert-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "621845903",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "621845904",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    // Keep the hosted PWA and local web origins during the transition.
    // Remove those three web origins after the landing page replaces the PWA.
    "CORS_ORIGIN": "https://bumpalert.thepixelwriter.com,http://localhost:8100,http://localhost:4200,https://localhost,capacitor://localhost",
    "PORT": "3000",
    "RESET_URL": "https://bumpalert.thepixelwriter.com/reset-password",
    "EMAIL_FROM": "noreply@thepixelwriter.com",
    "EMAIL_FROM_NAME": "BumpAlert",
    "GOOGLE_CLIENT_ID": "288699491060-dpqs0qkivrqa7d4dlka4s8slgkbu7koj.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bumpalert-db",
      "database_id": "5ab681bb-39d6-47dc-8855-1275c26aebd7",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "api.bumpalert.thepixelwriter.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}