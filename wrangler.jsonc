{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bumpalert-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGIN": "https://bumpalert.thepixelwriter.com,http://localhost:8100,http://localhost:4200",
    "PORT": "3000",
    "RESET_URL": "https://bumpalert.thepixelwriter.com/reset-password",
    "EMAIL_FROM": "noreply@bumpalert.thepixelwriter.com",
    "EMAIL_FROM_NAME": "BumpAlert"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bumpalert-db",
      "database_id": "5ab681bb-39d6-47dc-8855-1275c26aebd7",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "api.bumpalert.thepixelwriter.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}